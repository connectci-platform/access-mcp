    "better-sqlite3": "^11.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^22.0.0",
    "vitest": "^5.1.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.0",
    "@types/better-sqlite3": "^7.6.0"
  },
