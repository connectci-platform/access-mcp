mcp.access-ci.org {
    # OAuth auth service
    handle /auth/* {
        uri strip_prefix /auth
        reverse_proxy mcp-auth:3000
    }

    # OAuth endpoints advertised by metadata (SDK generates root-level paths)
    handle /authorize {
        reverse_proxy mcp-auth:3000
    }
    handle /token {
        reverse_proxy mcp-auth:3000
    }
    handle /register {
        reverse_proxy mcp-auth:3000
    }
    handle /revoke {
        reverse_proxy mcp-auth:3000
    }

    # OAuth well-known endpoints (served by auth service for all servers).
    # The bare-path glob (no trailing slash) also matches the extensionless
    # root form — an unmatched path here would get Caddy's default EMPTY 200,
    # which strict OAuth clients treat as authoritative broken metadata.
    handle /.well-known/oauth-protected-resource* {
        reverse_proxy mcp-auth:3000
    }
    # RFC 8414 metadata URL for issuer https://mcp.access-ci.org/auth: the
    # spec inserts the well-known segment BEFORE the issuer's path component,
    # so compliant clients (claude.ai connectors among them) resolve
    # /.well-known/oauth-authorization-server/auth FIRST — and only fall back
    # on 404, never on an empty 200. Rewrite both derivations (plus the
    # OIDC-discovery variant) to the root-form document the auth service
    # serves.
    handle /.well-known/oauth-authorization-server/auth {
        rewrite * /.well-known/oauth-authorization-server
        reverse_proxy mcp-auth:3000
    }
    handle /.well-known/openid-configuration/auth {
        rewrite * /.well-known/oauth-authorization-server
        reverse_proxy mcp-auth:3000
    }
    handle /.well-known/oauth-authorization-server {
        reverse_proxy mcp-auth:3000
    }

    handle /compute-resources/* {
        uri strip_prefix /compute-resources
        reverse_proxy mcp-compute-resources:3000 {
            flush_interval -1
            transport http {
                read_timeout 0
            }
        }
    }

    handle /system-status/* {
        uri strip_prefix /system-status
        reverse_proxy mcp-system-status:3000 {
            flush_interval -1
            transport http {
                read_timeout 0
            }
        }
    }

    handle /software-discovery/* {
        uri strip_prefix /software-discovery
        reverse_proxy mcp-software-discovery:3000 {
            flush_interval -1
            transport http {
                read_timeout 0
            }
        }
    }

    handle /xdmod/* {
        uri strip_prefix /xdmod
        reverse_proxy mcp-xdmod:3000 {
            flush_interval -1
            transport http {
                read_timeout 0
            }
        }
    }

    handle /allocations/* {
        uri strip_prefix /allocations
        reverse_proxy mcp-allocations:3000 {
            flush_interval -1
            transport http {
                read_timeout 0
            }
        }
    }

    handle /nsf-awards/* {
        uri strip_prefix /nsf-awards
        reverse_proxy mcp-nsf-awards:3000 {
            flush_interval -1
            transport http {
                read_timeout 0
            }
        }
    }

    handle /xdmod-data/* {
        uri strip_prefix /xdmod-data
        reverse_proxy mcp-xdmod-data:3000 {
            flush_interval -1
            transport http {
                read_timeout 0
            }
        }
    }

    handle /announcements/* {
        uri strip_prefix /announcements
        reverse_proxy mcp-announcements:3000 {
            flush_interval -1
            transport http {
                read_timeout 0
            }
        }
    }

    handle /documentation/* {
        uri strip_prefix /documentation
        reverse_proxy mcp-documentation:3000 {
            flush_interval -1
            transport http {
                read_timeout 0
            }
        }
    }

    handle /events/* {
        uri strip_prefix /events
        reverse_proxy mcp-events:3000 {
            flush_interval -1
            transport http {
                read_timeout 0
            }
        }
    }

    handle /affinity-groups/* {
        uri strip_prefix /affinity-groups
        reverse_proxy mcp-affinity-groups:3000 {
            flush_interval -1
            transport http {
                read_timeout 0
            }
        }
    }

    handle /jsm/* {
        uri strip_prefix /jsm
        reverse_proxy mcp-jsm:3000 {
            flush_interval -1
            transport http {
                read_timeout 0
            }
        }
    }

    @docs-no-slash path /docs
    redir @docs-no-slash /docs/ permanent

    handle /docs/* {
        uri strip_prefix /docs
        reverse_proxy https://access-mcp.netlify.app {
            header_up Host access-mcp.netlify.app
        }
    }

    handle / {
        respond "ACCESS-CI MCP Servers

Documentation: https://mcp.access-ci.org/docs/

Available MCP endpoints:
- /compute-resources/mcp
- /system-status/mcp
- /software-discovery/mcp
- /xdmod/mcp
- /allocations/mcp
- /nsf-awards/mcp
- /xdmod-data/mcp
- /announcements/mcp
- /events/mcp
- /affinity-groups/mcp
- /jsm/mcp
" 200
    }
}

qa.access-ci.org {
    # Reporting dashboard (Nuxt). The app expects the /dashboard prefix
    # (baseURL is baked in), so no path stripping. Bare /dashboard redirects
    # to /dashboard/ so relative assets resolve.
    redir /dashboard /dashboard/ 308
    handle /dashboard/* {
        reverse_proxy dashboard:3000
    }

    # Agent API (and its docs) — reachable on this Caddy's mcp-network as
    # access-agent. The agent serves only /api/v1/* plus FastAPI's /docs and
    # /openapi.json; keep the SSE-friendly settings on the streaming API path.
    handle /api/* {
        reverse_proxy access-agent:8000 {
            flush_interval -1
            transport http {
                read_timeout 0
            }
        }
    }
    handle /docs* {
        reverse_proxy access-agent:8000
    }
    handle /openapi.json {
        reverse_proxy access-agent:8000
    }

    # Everything else is the full-screen chat client, reachable as chatbot:3000.
    # Same-origin with the agent above, so its credentialed /api/* calls and the
    # .access-ci.org auth cookie flow with no CORS.
    handle {
        reverse_proxy chatbot:3000
    }

    log {
        output stdout
        format json
    }
}

# Host-specific extra site blocks (not in git). Each deployment host may drop a
# Caddyfile.local next to this file for services that live only on that host —
# e.g. the droplet serves a Discourse test instance at ask.cnct.ci. The glob
# matches zero files without error, so hosts with no local extras need nothing.
import Caddyfile.local*
